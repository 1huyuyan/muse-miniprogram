.hero { padding: 20rpx 8rpx 30rpx; }
.sub { color: #9a9ab0; font-size: 26rpx; margin-top: 12rpx; }

.img-grid { display: flex; flex-wrap: wrap; margin-top: 20rpx; }
.img-item { position: relative; width: 200rpx; height: 200rpx; margin: 0 16rpx 16rpx 0; }
.img { width: 100%; height: 100%; border-radius: 16rpx; }
.img-del {
  position: absolute; top: -12rpx; right: -12rpx;
  width: 44rpx; height: 44rpx; line-height: 40rpx;
  background: rgba(0,0,0,.6); color: #fff;
  text-align: center; border-radius: 50%; font-size: 30rpx;
}
.img-add {
  width: 200rpx; height: 200rpx; border: 2rpx dashed #c4c4d6; border-radius: 16rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  color: #9a9ab0;
}
.plus { font-size: 60rpx; line-height: 1; }
.add-text { font-size: 24rpx; margin-top: 8rpx; }

.line-ipt {
  background: #f4f5fa; border-radius: 12rpx;
  padding: 20rpx; font-size: 28rpx; margin-bottom: 24rpx;
}
.ph { color: #c4c4d6; }
.price-row { display: flex; align-items: center; }
.price-ipt { flex: 1; margin-bottom: 0; }
.price-sep { margin: 0 16rpx; color: #9a9ab0; }
.price-unit { margin-left: 16rpx; color: #9a9ab0; font-size: 26rpx; }
.tag-wrap { margin-top: 8rpx; }

.action { padding: 10rpx 0 60rpx; }
.disabled { opacity: 0.6; }
.link { margin-top: 20rpx; }
