.persona-summary { margin: 16rpx 0; font-size: 28rpx; line-height: 1.6; color: #444 }
.ip-banner { background: linear-gradient(135deg, #2d1b69, #6c5ce7); border: none; }
.ip-title { display: flex; align-items: center; }
.ip-badge {
  background: rgba(255,255,255,0.2); color: #fff;
  border-radius: 8rpx; font-size: 22rpx;
  padding: 6rpx 14rpx; margin-right: 16rpx; flex-shrink: 0;
}
.ip-name { color: #fff; font-size: 30rpx; font-weight: 600; }
.ip-note { margin-top: 12rpx; color: rgba(255,255,255,0.75); font-size: 24rpx; }
.chips { display: flex; flex-wrap: wrap; }
.chip {
  background: #f1efff; color: #6c5ce7; border-radius: 30rpx;
  padding: 8rpx 20rpx; font-size: 24rpx; margin: 0 12rpx 12rpx 0;
}
.rank-item { display: flex; align-items: flex-start; margin: 24rpx 0; }
.rank-thumb {
  width: 140rpx; height: 140rpx; border-radius: 16rpx;
  flex-shrink: 0; margin-left: 16rpx;
  background: #f0f0f6; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
}
.rank-badge {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  color: #fff; text-align: center; line-height: 56rpx;
  font-size: 30rpx; font-weight: 700; flex-shrink: 0;
  background: #c4c4d6;
}
.rank-1 { background: linear-gradient(135deg, #f6c343, #f39c12) !important; }
.rank-2 { background: linear-gradient(135deg, #bdc3c7, #95a5a6) !important; }
.rank-3 { background: linear-gradient(135deg, #dda15e, #bc6c25) !important; }
.rank-info { margin-left: 20rpx; flex: 1; }
.rank-head { display: flex; align-items: center; justify-content: space-between; }
.rank-name { font-size: 32rpx; font-weight: 600; }
.rank-brand { font-size: 24rpx; color: #9a9ab0; font-weight: 400; margin-left: 16rpx; flex-shrink: 0; }
.rank-price { color: #e17055; font-size: 26rpx; margin-top: 6rpx; }
.rank-tags { margin-top: 10rpx; }
.r-tag {
  background: #f4f5fa; color: #7a7a92; font-size: 22rpx;
  border-radius: 20rpx; padding: 4rpx 16rpx; margin-right: 10rpx;
}
.rank-relation {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #b08968;
  background: #faf3ea;
  border-radius: 8rpx;
  padding: 6rpx 12rpx;
  display: inline-block;
}

.rag-degraded {
  margin: 16rpx 0;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: #fdf6ec;
  border: 1rpx dashed #e0b27a;
  color: #9a6b3f;
  font-size: 24rpx;
  line-height: 1.6;
}

.ip-miss {
  margin: 16rpx 0;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: #f4f6fb;
  border: 1rpx dashed #9aa5c9;
  color: #6b7a99;
  font-size: 24rpx;
  line-height: 1.6;
}

.rank-reason { margin-top: 12rpx; font-size: 26rpx; color: #6c5ce7; background: #f6f5ff; padding: 14rpx; border-radius: 12rpx; line-height: 1.6; }

.talk {
  margin-top: 16rpx; background: #f6f5ff; border-radius: 12rpx;
  padding: 20rpx; font-size: 28rpx; line-height: 1.7; color: #555;
}
.action { padding: 20rpx 0 60rpx; }

/* 不满意反馈入口 */
.feedback-input-wrap { margin: 16rpx 0 20rpx; }
.feedback-input {
  width: 100%; box-sizing: border-box;
  background: #f4f5fa; border-radius: 12rpx;
  padding: 20rpx; font-size: 28rpx; min-height: 120rpx;
}
