/* app.wxss - 全局样式 */
page {
  background: #f6f7fb;
  font-size: 28rpx;
  color: #2d2d3a;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(26, 26, 46, 0.06);
}

.btn-primary {
  background: linear-gradient(135deg, #6c5ce7, #a29bfe);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 22rpx 0;
  text-align: center;
}

.btn-primary:active { opacity: 0.85; }

.btn-plain {
  background: #fff;
  color: #6c5ce7;
  border: 2rpx solid #6c5ce7;
  border-radius: 48rpx;
  font-size: 30rpx;
  padding: 18rpx 0;
  text-align: center;
}

.tag {
  display: inline-block;
  background: #f1efff;
  color: #6c5ce7;
  border-radius: 30rpx;
  padding: 10rpx 24rpx;
  font-size: 26rpx;
  margin: 0 16rpx 16rpx 0;
}

.tag.active {
  background: #6c5ce7;
  color: #fff;
}

.title-lg {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.title-md {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.text-muted {
  color: #9a9ab0;
  font-size: 24rpx;
}

.empty {
  text-align: center;
  color: #9a9ab0;
  padding: 80rpx 0;
}
